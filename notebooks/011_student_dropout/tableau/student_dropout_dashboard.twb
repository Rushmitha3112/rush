<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2023.3.0' source-platform='mac' version='21.3' xmlns:user='http://www.tableausoftware.com/xml/user'>

  <datasources>
    <datasource caption='Student Dropout Predictions' name='student_dropout' inline='true'>
      <!-- Connect to artifacts/predictions.csv generated by the notebook -->
      <connection class='textscan' filename='../artifacts/predictions.csv'
                  separator=',' locale='en_US'>
        <relation name='predictions' type='text'/>
      </connection>
      <column datatype='integer' name='[student_id]'         role='dimension' type='ordinal'/>
      <column datatype='string'  name='[gender]'             role='dimension' type='nominal'/>
      <column datatype='string'  name='[enrollment_type]'    role='dimension' type='nominal'/>
      <column datatype='string'  name='[scholarship]'        role='dimension' type='nominal'/>
      <column datatype='integer' name='[age_at_enrollment]'  role='measure'   type='quantitative'/>
      <column datatype='real'    name='[gpa_1st_sem]'        role='measure'   type='quantitative' caption='GPA 1st Sem'/>
      <column datatype='real'    name='[gpa_2nd_sem]'        role='measure'   type='quantitative' caption='GPA 2nd Sem'/>
      <column datatype='integer' name='[units_enrolled]'     role='measure'   type='quantitative'/>
      <column datatype='integer' name='[units_approved]'     role='measure'   type='quantitative'/>
      <column datatype='string'  name='[actual_outcome]'     role='dimension' type='nominal'/>
      <column datatype='string'  name='[predicted_outcome]'  role='dimension' type='nominal'/>
      <column datatype='real'    name='[dropout_probability]' role='measure'  type='quantitative' caption='Dropout Probability'/>
      <!-- calculated fields -->
      <column caption='Correct Prediction' datatype='boolean' name='[calc_correct]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[actual_outcome] = [predicted_outcome]'/>
      </column>
      <column caption='Risk Band' datatype='string' name='[calc_risk_band]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='
          IF [dropout_probability] >= 0.7 THEN "High Risk"
          ELSEIF [dropout_probability] >= 0.4 THEN "Medium Risk"
          ELSE "Low Risk"
          END'/>
      </column>
      <column caption='GPA Delta' datatype='real' name='[calc_gpa_delta]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gpa_2nd_sem] - [gpa_1st_sem]'/>
      </column>
      <column caption='Approval Rate %' datatype='real' name='[calc_approval_rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[units_approved] / [units_enrolled] * 100'/>
      </column>
    </datasource>
  </datasources>

  <worksheets>

    <!-- Sheet 1: Dropout Probability Distribution -->
    <worksheet name='Dropout Probability Distribution'>
      <table>
        <view>
          <datasources>
            <datasource name='student_dropout' caption='Student Dropout Predictions'/>
          </datasources>
          <datasource-dependencies datasource='student_dropout'>
            <column-instance column='[dropout_probability]' derivation='None' name='[none:dropout_probability:qk]' pivot='key' type='quantitative'/>
            <column-instance column='[actual_outcome]'      derivation='None' name='[none:actual_outcome:nk]'      pivot='key' type='nominal'/>
          </datasource-dependencies>
          <mark class='Bar'/>
          <encoding>
            <column field='[none:dropout_probability:qk]' type='quantitative' bin-size='0.05'/>
            <row    field='[none:dropout_probability:qk]' type='quantitative' derivation='Count'/>
            <color  field='[none:actual_outcome:nk]'      type='nominal'/>
          </encoding>
        </view>
        <style>
          <style-rule element='view'>
            <encoding attr='display-title' value='Dropout Probability Distribution by Actual Outcome'/>
          </style-rule>
        </style>
      </table>
    </worksheet>

    <!-- Sheet 2: Risk Band × Enrollment Type -->
    <worksheet name='Risk Band by Enrollment Type'>
      <table>
        <view>
          <datasources>
            <datasource name='student_dropout'/>
          </datasources>
          <datasource-dependencies datasource='student_dropout'>
            <column-instance column='[calc_risk_band]'    derivation='None' name='[none:calc_risk_band:nk]'    pivot='key' type='nominal'/>
            <column-instance column='[enrollment_type]'   derivation='None' name='[none:enrollment_type:nk]'   pivot='key' type='nominal'/>
            <column-instance column='[student_id]'        derivation='Count' name='[cnt:student_id:qk]'        pivot='key' type='quantitative'/>
          </datasource-dependencies>
          <mark class='Bar'/>
          <encoding>
            <column field='[none:enrollment_type:nk]'  type='nominal'/>
            <row    field='[cnt:student_id:qk]'        type='quantitative'/>
            <color  field='[none:calc_risk_band:nk]'   type='nominal'
                    palette='traffic-light'/>
          </encoding>
        </view>
        <style>
          <style-rule element='view'>
            <encoding attr='display-title' value='Students by Risk Band and Enrollment Type'/>
          </style-rule>
        </style>
      </table>
    </worksheet>

    <!-- Sheet 3: GPA Scatter (1st vs 2nd sem, colored by outcome) -->
    <worksheet name='GPA Trajectory'>
      <table>
        <view>
          <datasources>
            <datasource name='student_dropout'/>
          </datasources>
          <datasource-dependencies datasource='student_dropout'>
            <column-instance column='[gpa_1st_sem]'      derivation='None' name='[none:gpa_1st_sem:qk]'    pivot='key' type='quantitative'/>
            <column-instance column='[gpa_2nd_sem]'      derivation='None' name='[none:gpa_2nd_sem:qk]'    pivot='key' type='quantitative'/>
            <column-instance column='[actual_outcome]'   derivation='None' name='[none:actual_outcome:nk]' pivot='key' type='nominal'/>
            <column-instance column='[dropout_probability]' derivation='None' name='[none:dropout_probability:qk2]' pivot='key' type='quantitative'/>
          </datasource-dependencies>
          <mark class='Circle'/>
          <encoding>
            <column field='[none:gpa_1st_sem:qk]'          type='quantitative'/>
            <row    field='[none:gpa_2nd_sem:qk]'          type='quantitative'/>
            <color  field='[none:actual_outcome:nk]'        type='nominal'/>
            <size   field='[none:dropout_probability:qk2]'  type='quantitative'/>
            <opacity value='0.6'/>
          </encoding>
        </view>
        <style>
          <style-rule element='view'>
            <encoding attr='display-title' value='GPA Trajectory: 1st vs 2nd Semester (bubble = dropout probability)'/>
          </style-rule>
        </style>
      </table>
    </worksheet>

    <!-- Sheet 4: Feature Importance Bar Chart -->
    <worksheet name='Feature Importance'>
      <table>
        <view>
          <datasources>
            <datasource name='student_dropout'/>
          </datasources>
          <datasource-dependencies datasource='student_dropout'>
            <column-instance column='[calc_gpa_delta]'    derivation='Avg' name='[avg:calc_gpa_delta:qk]'    pivot='key' type='quantitative'/>
            <column-instance column='[calc_risk_band]'    derivation='None' name='[none:calc_risk_band:nk]'  pivot='key' type='nominal'/>
            <column-instance column='[calc_approval_rate]' derivation='Avg' name='[avg:calc_approval_rate:qk]' pivot='key' type='quantitative'/>
          </datasource-dependencies>
          <mark class='Bar'/>
          <encoding>
            <column field='[none:calc_risk_band:nk]'       type='nominal'/>
            <row    field='[avg:calc_gpa_delta:qk]'        type='quantitative'/>
            <color  field='[none:calc_risk_band:nk]'       type='nominal' palette='traffic-light'/>
          </encoding>
        </view>
        <style>
          <style-rule element='view'>
            <encoding attr='display-title' value='Average GPA Delta by Risk Band'/>
          </style-rule>
        </style>
      </table>
    </worksheet>

    <!-- Sheet 5: Scholarship Impact on Dropout Rate -->
    <worksheet name='Scholarship Impact'>
      <table>
        <view>
          <datasources>
            <datasource name='student_dropout'/>
          </datasources>
          <datasource-dependencies datasource='student_dropout'>
            <column-instance column='[scholarship]'      derivation='None' name='[none:scholarship:nk]'     pivot='key' type='nominal'/>
            <column-instance column='[actual_outcome]'   derivation='None' name='[none:actual_outcome:nk]'  pivot='key' type='nominal'/>
            <column-instance column='[student_id]'       derivation='Count' name='[cnt:student_id:qk]'      pivot='key' type='quantitative'/>
          </datasource-dependencies>
          <mark class='Bar'/>
          <encoding>
            <column field='[none:scholarship:nk]'     type='nominal'/>
            <row    field='[cnt:student_id:qk]'       type='quantitative' mark-type='Percent'/>
            <color  field='[none:actual_outcome:nk]'  type='nominal'/>
          </encoding>
        </view>
        <style>
          <style-rule element='view'>
            <encoding attr='display-title' value='Outcome Distribution by Scholarship Status'/>
          </style-rule>
        </style>
      </table>
    </worksheet>

  </worksheets>

  <dashboards>
    <dashboard name='Student Dropout Risk Dashboard'>
      <size maxheight='1080' maxwidth='1920' minheight='768' minwidth='1024'/>
      <zones>
        <zone type='layout-flow' id='1' w='1800' h='1000' x='60' y='40'>
          <zone type='layout-flow' layoutflow='row' id='2' w='1800' h='480'>
            <zone type='view' id='3' w='900' h='480' name='Dropout Probability Distribution'/>
            <zone type='view' id='4' w='900' h='480' name='GPA Trajectory'/>
          </zone>
          <zone type='layout-flow' layoutflow='row' id='5' w='1800' h='480'>
            <zone type='view' id='6' w='600' h='480' name='Risk Band by Enrollment Type'/>
            <zone type='view' id='7' w='600' h='480' name='Feature Importance'/>
            <zone type='view' id='8' w='600' h='480' name='Scholarship Impact'/>
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>

</workbook>
