<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2023.3.0' source-platform='mac' version='21.3' xmlns:user='http://www.tableausoftware.com/xml/user'>

  <datasources>
    <datasource caption='Fraud Drift Monitor' name='fraud_drift' inline='true'>
      <!-- Connect to artifacts/drift_summary.csv generated by the notebook -->
      <connection class='textscan' filename='../artifacts/drift_summary.csv'
                  separator=',' locale='en_US'>
        <relation name='drift_summary' type='text'/>
      </connection>
      <column datatype='string'  name='[feature]'            role='dimension' type='nominal'/>
      <column datatype='string'  name='[scenario]'           role='dimension' type='nominal'/>
      <column datatype='real'    name='[psi_score]'           role='measure'   type='quantitative' caption='PSI Score'/>
      <column datatype='real'    name='[wasserstein_dist]'    role='measure'   type='quantitative' caption='Wasserstein Distance'/>
      <column datatype='real'    name='[ks_statistic]'        role='measure'   type='quantitative' caption='KS Statistic'/>
      <column datatype='real'    name='[drift_detected]'      role='dimension' type='nominal'/>
      <column datatype='real'    name='[baseline_mean]'       role='measure'   type='quantitative'/>
      <column datatype='real'    name='[drift_mean]'          role='measure'   type='quantitative'/>
      <!-- calculated fields -->
      <column caption='Drift Severity' datatype='string' name='[calc_severity]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='
          IF [psi_score] >= 0.25 THEN "High"
          ELSEIF [psi_score] >= 0.1 THEN "Medium"
          ELSE "Low"
          END'/>
      </column>
      <column caption='Mean Shift %' datatype='real' name='[calc_mean_shift_pct]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([drift_mean] - [baseline_mean]) / [baseline_mean] * 100'/>
      </column>
    </datasource>

    <datasource caption='Fraud Predictions Over Time' name='fraud_preds' inline='true'>
      <!-- Connect to artifacts/predictions_timeline.csv -->
      <connection class='textscan' filename='../artifacts/predictions_timeline.csv'
                  separator=',' locale='en_US'>
        <relation name='predictions_timeline' type='text'/>
      </connection>
      <column datatype='date'    name='[batch_date]'          role='dimension' type='ordinal'/>
      <column datatype='string'  name='[scenario]'            role='dimension' type='nominal'/>
      <column datatype='real'    name='[fraud_rate_actual]'   role='measure'   type='quantitative'/>
      <column datatype='real'    name='[fraud_rate_predicted]' role='measure'  type='quantitative'/>
      <column datatype='real'    name='[precision]'           role='measure'   type='quantitative'/>
      <column datatype='real'    name='[recall]'              role='measure'   type='quantitative'/>
      <column datatype='real'    name='[f1]'                  role='measure'   type='quantitative'/>
    </datasource>
  </datasources>

  <worksheets>

    <!-- Sheet 1: PSI Heatmap — Feature × Scenario -->
    <worksheet name='PSI Drift Heatmap'>
      <table>
        <view>
          <datasources>
            <datasource name='fraud_drift' caption='Fraud Drift Monitor'/>
          </datasources>
          <datasource-dependencies datasource='fraud_drift'>
            <column-instance column='[feature]'   derivation='None' name='[none:feature:nk]'   pivot='key' type='nominal'/>
            <column-instance column='[scenario]'  derivation='None' name='[none:scenario:nk]'  pivot='key' type='nominal'/>
            <column-instance column='[psi_score]' derivation='Avg'  name='[avg:psi_score:qk]'  pivot='key' type='quantitative'/>
          </datasource-dependencies>
          <mark class='Square'/>
          <encoding>
            <column field='[none:scenario:nk]'  type='nominal'/>
            <row    field='[none:feature:nk]'   type='nominal'/>
            <color  field='[avg:psi_score:qk]'  type='quantitative' palette='red-gold'/>
            <label  field='[avg:psi_score:qk]'  type='quantitative' format='0.000'/>
            <size   value='0.9'/>
          </encoding>
        </view>
        <style>
          <style-rule element='view'>
            <encoding attr='display-title' value='PSI Score Heatmap — Feature × Drift Scenario'/>
          </style-rule>
        </style>
      </table>
    </worksheet>

    <!-- Sheet 2: Drift Severity Bar Chart by Feature -->
    <worksheet name='Drift Severity by Feature'>
      <table>
        <view>
          <datasources>
            <datasource name='fraud_drift'/>
          </datasources>
          <datasource-dependencies datasource='fraud_drift'>
            <column-instance column='[feature]'        derivation='None' name='[none:feature:nk]'        pivot='key' type='nominal'/>
            <column-instance column='[calc_severity]'  derivation='None' name='[none:calc_severity:nk]'  pivot='key' type='nominal'/>
            <column-instance column='[psi_score]'      derivation='Avg'  name='[avg:psi_score:qk]'       pivot='key' type='quantitative'/>
          </datasource-dependencies>
          <mark class='Bar'/>
          <encoding>
            <column field='[avg:psi_score:qk]'        type='quantitative'/>
            <row    field='[none:feature:nk]'          type='nominal' sort='descending'/>
            <color  field='[none:calc_severity:nk]'   type='nominal' palette='traffic-light'/>
          </encoding>
        </view>
        <style>
          <style-rule element='view'>
            <encoding attr='display-title' value='Average PSI by Feature (colored by Drift Severity)'/>
          </style-rule>
        </style>
      </table>
    </worksheet>

    <!-- Sheet 3: Model Performance Degradation Over Time -->
    <worksheet name='Performance Degradation'>
      <table>
        <view>
          <datasources>
            <datasource name='fraud_preds' caption='Fraud Predictions Over Time'/>
          </datasources>
          <datasource-dependencies datasource='fraud_preds'>
            <column-instance column='[batch_date]' derivation='Month' name='[month:batch_date:ok]' pivot='key' type='ordinal'/>
            <column-instance column='[f1]'         derivation='Avg'   name='[avg:f1:qk]'           pivot='key' type='quantitative'/>
            <column-instance column='[scenario]'   derivation='None'  name='[none:scenario:nk]'    pivot='key' type='nominal'/>
          </datasource-dependencies>
          <mark class='Line'/>
          <encoding>
            <column field='[month:batch_date:ok]' type='ordinal'/>
            <row    field='[avg:f1:qk]'           type='quantitative'/>
            <color  field='[none:scenario:nk]'    type='nominal'/>
          </encoding>
        </view>
        <style>
          <style-rule element='view'>
            <encoding attr='display-title' value='F1 Score Over Time by Drift Scenario'/>
          </style-rule>
        </style>
      </table>
    </worksheet>

    <!-- Sheet 4: Actual vs Predicted Fraud Rate -->
    <worksheet name='Fraud Rate Comparison'>
      <table>
        <view>
          <datasources>
            <datasource name='fraud_preds'/>
          </datasources>
          <datasource-dependencies datasource='fraud_preds'>
            <column-instance column='[batch_date]'          derivation='Month' name='[month:batch_date:ok]'    pivot='key' type='ordinal'/>
            <column-instance column='[fraud_rate_actual]'   derivation='Avg'   name='[avg:fraud_rate_actual:qk]'    pivot='key' type='quantitative'/>
            <column-instance column='[fraud_rate_predicted]' derivation='Avg'  name='[avg:fraud_rate_predicted:qk]' pivot='key' type='quantitative'/>
            <column-instance column='[scenario]'            derivation='None'  name='[none:scenario:nk]'        pivot='key' type='nominal'/>
          </datasource-dependencies>
          <mark class='Line'/>
          <encoding>
            <column field='[month:batch_date:ok]'             type='ordinal'/>
            <row    field='[avg:fraud_rate_actual:qk]'        type='quantitative'/>
            <row    field='[avg:fraud_rate_predicted:qk]'     type='quantitative'/>
            <color  field='[none:scenario:nk]'               type='nominal'/>
          </encoding>
        </view>
        <style>
          <style-rule element='view'>
            <encoding attr='display-title' value='Actual vs Predicted Fraud Rate Over Time'/>
          </style-rule>
        </style>
      </table>
    </worksheet>

    <!-- Sheet 5: Mean Shift by Scenario (scatter of drift magnitude) -->
    <worksheet name='Mean Shift by Scenario'>
      <table>
        <view>
          <datasources>
            <datasource name='fraud_drift'/>
          </datasources>
          <datasource-dependencies datasource='fraud_drift'>
            <column-instance column='[scenario]'          derivation='None' name='[none:scenario:nk]'          pivot='key' type='nominal'/>
            <column-instance column='[feature]'           derivation='None' name='[none:feature:nk]'           pivot='key' type='nominal'/>
            <column-instance column='[calc_mean_shift_pct]' derivation='None' name='[none:calc_mean_shift:qk]' pivot='key' type='quantitative'/>
            <column-instance column='[ks_statistic]'      derivation='None' name='[none:ks_statistic:qk]'     pivot='key' type='quantitative'/>
          </datasource-dependencies>
          <mark class='Circle'/>
          <encoding>
            <column field='[none:calc_mean_shift:qk]' type='quantitative'/>
            <row    field='[none:ks_statistic:qk]'    type='quantitative'/>
            <color  field='[none:scenario:nk]'        type='nominal'/>
            <shape  field='[none:feature:nk]'         type='nominal'/>
            <opacity value='0.75'/>
          </encoding>
        </view>
        <style>
          <style-rule element='view'>
            <encoding attr='display-title' value='Mean Shift % vs KS Statistic — Feature Drift Scatter'/>
          </style-rule>
        </style>
      </table>
    </worksheet>

  </worksheets>

  <dashboards>
    <dashboard name='Fraud Model Drift Monitoring Dashboard'>
      <size maxheight='1080' maxwidth='1920' minheight='768' minwidth='1024'/>
      <zones>
        <zone type='layout-flow' id='1' w='1800' h='1000' x='60' y='40'>
          <zone type='layout-flow' layoutflow='row' id='2' w='1800' h='500'>
            <zone type='view' id='3' w='700' h='500' name='PSI Drift Heatmap'/>
            <zone type='view' id='4' w='1100' h='500' name='Performance Degradation'/>
          </zone>
          <zone type='layout-flow' layoutflow='row' id='5' w='1800' h='460'>
            <zone type='view' id='6' w='600' h='460' name='Drift Severity by Feature'/>
            <zone type='view' id='7' w='600' h='460' name='Fraud Rate Comparison'/>
            <zone type='view' id='8' w='600' h='460' name='Mean Shift by Scenario'/>
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>

</workbook>
